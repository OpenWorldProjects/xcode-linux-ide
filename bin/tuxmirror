#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT=8080

# Check if USB mirror daemon is running
if ! ss -tlpn | grep -q ":${PORT} "; then
    echo "Starting tuxmirror USB capture engine on port ${PORT}..."
    node "${DIR}/../packages/tuxcodebuild/src/usb-mirror.js" >/dev/null 2>&1 &
    sleep 2
fi

echo "=========================================================="
echo "🐧 tuxmirror - 100% Direct USB iPhone Mirror"
echo "=========================================================="
echo "Launching standalone window on your desktop..."

export DISPLAY="${DISPLAY:-:0}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

if command -v google-chrome >/dev/null 2>&1; then
    exec google-chrome --app="http://127.0.0.1:${PORT}" --window-size=440,940
elif command -v firefox >/dev/null 2>&1; then
    exec firefox --new-window "http://127.0.0.1:${PORT}"
else
    echo "Open in browser: http://127.0.0.1:${PORT}"
fi
